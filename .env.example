# Copy this file to .env and fill in your details
# The .env file is gitignored — never commit it.

# Your FPL team ID (visible in the URL of your team page)
# e.g. https://fantasy.premierleague.com/entry/1234567/event/1 -> 1234567
FPL_TEAM_ID=1234567

# Preferred auth (2026-27): Bearer JWT copied from the browser.
# DevTools -> Network -> any /api/ request -> copy the value of the
# x-api-authorization header, strip the leading "Bearer ".
# Expires roughly every 8 hours; refresh the same way when private
# endpoints start returning 401.
FPL_API_TOKEN=

# Legacy fallbacks (browser cookie string; note: the old
# users.premierleague.com credential login no longer exists)
# FPL_COOKIE=pl_profile=...
# FPL_EMAIL=your@email.com
# FPL_PASSWORD=your_password_here

# Path to persist the session cookie between restarts (optional)
FPL_SESSION_FILE=fpl_session.json
